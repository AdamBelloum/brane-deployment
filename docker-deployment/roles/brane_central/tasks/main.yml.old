---
- name: Fix legacy OpenSSL dependency for branectl (Ubuntu 22.04+)
  block:
    - name: Download legacy libssl1.1 package
      get_url:
        url: "http://archive.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2_amd64.deb"
        dest: "/tmp/libssl1.1.deb"
        mode: '0644'

    - name: Install legacy libssl1.1 via dpkg
      apt:
        deb: "/tmp/libssl1.1.deb"
      become: yes
  ignore_errors: yes

- name: Download and install the latest official branectl binary
  get_url:
    url: "https://github.com/BraneFramework/brane/releases/latest/download/branectl-linux-x86_64"
    dest: "/usr/local/bin/branectl"
    mode: '0755'
    force: yes
  become: yes

- name: Ensure Brane Central Hub target release folder structure exists
  file:
    path: "{{ ansible_facts['env']['HOME'] }}/brane-central/target/release"
    state: directory
    mode: '0755'

# --- Step 1: Download Service Images ---
- name: Download core central service image asset bundle from working repo
  get_url:
    url: "https://github.com/BraneFramework/brane/releases/download/v3.0.0/instance-x86_64.tar.gz"
    dest: "{{ ansible_facts['env']['HOME'] }}/brane-central/target/release/instance-x86_64.tar.gz"
    mode: '0644'

# --- Step 2: Generate Configuration ---
- name: Generate Infrastructure configuration map
  command: >
    branectl generate infra -f -p ./config/infra.yml 
    client-node-1:145.100.135.172 
    client-node-2:145.100.135.241
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/brane-central"

- name: Generate Proxy configuration mesh rules
  command: "branectl generate proxy -f -p ./config/proxy.yml"
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/brane-central"

- name: Generate Node configuration definitions
  command: "branectl generate node -f central {{ central_ip }}"
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/brane-central"
    creates: "{{ ansible_facts['env']['HOME'] }}/brane-central/node.yml"

# --- Step 2.5: Ensure directory exists ---
- name: Create certificate directory
  file:
    path: "{{ ansible_facts['env']['HOME'] }}/config/certs"
    state: directory
    mode: '0755'

# --- Step 3: Initialize Root Authority ---
- name: Generate Root Trust Authority Certificates
  command: branectl generate certs -f -p . server central
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/config/certs"
    creates: "{{ ansible_facts['env']['HOME'] }}/config/certs/ca.pem"

- name: Generate Client Certificates
  shell: |
    # Force the use of the local directory for all operations
    export TMPDIR="{{ ansible_facts['env']['HOME'] }}/config/certs/client_gen"
    branectl generate certs -f -p . client {{ item }}
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/config/certs/client_gen"
    executable: /bin/bash
  loop:
    - client-node-1
    - client-node-2

- name: Create symlinks for CA trust
  file:
    src: "{{ ansible_facts['env']['HOME'] }}/config/certs/{{ item }}"
    dest: "{{ ansible_facts['env']['HOME'] }}/config/certs/client_gen/{{ item }}"
    state: link
  loop:
    - ca.pem
    - ca-key.pem

- name: Generate Client Certificates
  shell: |
    # 1. Ensure we are in the directory with the valid CA files
    #cd "{{ ansible_facts['env']['HOME'] }}/config/certs"
    
    # 2. Run the command using the absolute path to the CA files
    # We bypass the symlink-jail because we are now targeting the source files directly
    # branectl generate certs -f -p . client {{ item }}
    branectl generate certs -f -p . -c ./ca-config.json client {{ item }}
  args:
    # executable: /bin/bash
    chdir: "{{ ansible_facts['env']['HOME'] }}/config/certs"
  loop:
    - client-node-1
    - client-node-2
  # 3. Add a delay to prevent file handle collision
  register: cert_gen
  until: cert_gen is succeeded
  retries: 3
  delay: 2

# --- Step 5: Securely pull CA and Client artifacts ---
- name: Securely pull certificates to regional management hub
  fetch:
    # Adjust path to pull from the jail where they were created
    src: "{{ ansible_facts['env']['HOME'] }}/config/certs/{{ 'client_gen/' if 'client' in item else '' }}{{ item }}"
    dest: "/tmp/brane_certs/{{ item }}"
    flat: yes
  loop:
    - ca.pem
    - ca-key.pem
    - client-node-1.pem
    - client-node-2.pem

# --- Step 6: Start the Node ---
- name: Execute local stack initialization
  command: branectl start central
  args:
    chdir: "{{ ansible_facts['env']['HOME'] }}/brane-central"
