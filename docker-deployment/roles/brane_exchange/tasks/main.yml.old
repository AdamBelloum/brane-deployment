---
# roles/brane_exchange/tasks/main.yml




# 1. Distribute the CA from Control Node to Workers first
#- name: Distribute Cluster CA to all worker nodes
#  ansible.builtin.copy:
#    src: "~/brane-central/config/certs/ca.pem"
#    dest: "~/brane-central/config/certs/ca.pem"
#  delegate_to: hub-vm-1


# 1. Read the CA file from the Hub into memory
- name: Distribute CA files to all worker nodes
  ansible.builtin.copy:
    src: "config/certs/{{ item }}"
    dest: "~/brane-central/config/certs/{{ item }}"
  loop:
    - ca.pem
    - ca-key.pem
  when: inventory_hostname in groups['worker_nodes']

# 2. Distribute the content to all worker nodes
- name: Distribute Cluster CA to all worker nodes
  ansible.builtin.copy:
    content: "{{ remote_ca_file.content | b64decode }}"
    dest: ~/brane-central/config/certs/ca.pem
  when: inventory_hostname in groups['worker_nodes']

# 2. NOW generate worker certs (now that ca.pem is present on workers)
#- name: Generate worker certs on worker nodes
  #  ansible.builtin.command: "branectl generate certs client {{ location_id }} -H {{ node_ip }} -f -p ./config/certs"
  #  args: { chdir: ~/brane-central }
  #when: "'worker_nodes' in group_names"

# 2. NOW, set up the worker environment
- name: Ensure certificate directory exists on workers
  ansible.builtin.file:
    path: ~/brane-central/config/certs/
    state: directory

- name: Ensure ca.pem exists in working directory
  ansible.builtin.copy:
    src: ~/brane-central/config/certs/ca.pem
    dest: ~/brane-central/config/certs/ca.pem
    remote_src: yes 

#- name: Generate worker certs on worker nodes
#  ansible.builtin.command:
#    cmd: "branectl generate certs client {{ location_id }} -H {{ node_ip }} -f -p ~/brane-central/config/certs/"
#    chdir: ~/brane-central/config/certs/
#  when: inventory_hostname in groups['worker_nodes']
   
- name: Generate worker certs on worker nodes
  ansible.builtin.command:
    # We specify the directory as the current working directory (.)
    cmd: "branectl generate certs client {{ location_id }} -H {{ node_ip }} -f -p ."
    # This changes the working directory before running the command
    chdir: ~/brane-central/config/certs/
  when: inventory_hostname in groups['worker_nodes']


# 3. Fetch worker public certs to controller
- name: Fetch worker public certs
  ansible.builtin.fetch:
    src: "~/brane-central/config/certs/client-id.pem"
    dest: "./certs_cache/{{ inventory_hostname }}/client-id.pem" # Must be the full filename
    flat: yes
  when: "'worker_nodes' in group_names"

# 4. Distribute worker certs to Central Node
- name: Copy to Central Node registry
  ansible.builtin.copy:
    src: "./certs_cache/{{ item }}/client-id.pem"
    dest: "~/brane-central/config/certs/{{ item }}-id.pem" # Unique name for each worker
  loop: "{{ groups['worker_nodes'] }}"
  delegate_to: hub-vm-1

