# scripts/.brane_helper.env.example
#
# Copy this file to scripts/.brane_helper.env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp scripts/.brane_helper.env.example scripts/.brane_helper.env
#   $EDITOR scripts/.brane_helper.env

# ── Paths ──────────────────────────────────────────────────────────────────
# Absolute path to the docker-deployment directory.
# Defaults to <repo-root>/docker-deployment if left empty.
BRANE_DEPLOY_HOME=""

# Path to the packages directory used by the Brane CLI.
# Defaults to <repo-root>/frontend/packages if left empty.
PACKAGE_DIR=""

# ── Infrastructure ─────────────────────────────────────────────────────────
# IP address of the central hub VM
HOST_IP="192.168.1.10"

# Brane service ports
PORT_REPL="50053"
PORT_REGISTRY="50051"

# Fully-qualified domain name of the central hub (used for brane instance add)
INSTANCE_DOMAIN="central-hub.example.com"

# Local alias name for this Brane instance
INSTANCE_NAME="my-brane"

# ── Package defaults ────────────────────────────────────────────────────────
PACKAGE_NAME="hello_world"
WORKFLOW_NAME="hello_world.bs"
CONTAINER_YML="container.yml"
PACKAGE_VERSION="1.0.0"

